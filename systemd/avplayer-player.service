[Unit]
Description=AV Player - Video oynatma motoru (mpv gözetmeni)
# Ağ ZORUNLU DEĞİL: sistem tamamen offline çalışır, daemon ağı en fazla 5 sn bekler.
After=local-fs.target sound.target systemd-udev-settle.service multi-user.target
Wants=sound.target systemd-udev-settle.service

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=45
EnvironmentFile=/etc/avplayer.env
WorkingDirectory=/opt/avplayer
RuntimeDirectory=avplayer
RuntimeDirectoryPreserve=yes
ExecStartPre=-/bin/sh -c 'chvt 1; clear >/dev/tty1'
ExecStart=/opt/avplayer/venv/bin/python -m app.player_daemon
Restart=always
RestartSec=2
StartLimitIntervalSec=0
KillMode=control-group
TimeoutStopSec=10
# mpv DRM/KMS'e (masaüstü olmadan) doğrudan çizer
SupplementaryGroups=video audio render input
StandardInput=null
Nice=-5

[Install]
WantedBy=multi-user.target
